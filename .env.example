# Copia este fichero a .env y ajusta los valores.
# NUNCA subas .env al repositorio: esta en .gitignore.

# --- Modelo de inferencia ---------------------------------------------------
# Esta es LA decision del proyecto, no un ajuste. Las dos configuraciones son
# validas y miden cosas distintas; la memoria deberia reportar ambas.
#
#   qwen2.5-coder:0.5b  (por defecto)   ~400 MB   ~11 ms/token en CPU
#     La ruta generativa cabe en la misma banda temporal que la determinista,
#     asi que la normalizacion de latencia se sostiene y la indistinguibilidad
#     temporal es alcanzable. Se paga en calidad de la salida inventada.
#
#   qwen2.5-coder:3b    (alternativa)   ~2 GB     ~45 ms/token en CPU
#     Salida notablemente mas verosimil. Pero la ruta generativa mide
#     ~2.044 ms +/- 7,3 frente a ~2,4 ms +/- 1,6 de la determinista: dos
#     poblaciones separadas por dos segundos que el relleno NO puede juntar
#     dentro de un objetivo de 1.000 ms, porque solo puede anadir tiempo.
#     Es la linea base BIMODAL del capitulo 4, y para medirla hay que apagar
#     la normalizacion (LATENCY_NORMALIZE=false): dejarla encendida con el 3b
#     produce una latencia alta sin ganar indistinguibilidad.
#
# Razonamiento completo y cifras: README seccion 4.
MODEL_NAME=qwen2.5-coder:0.5b

# --- Objetivo de rendimiento ------------------------------------------------
# Umbral de latencia en ms. Por encima se emite un evento system.latency_breach.
LATENCY_TARGET_MS=1000

# Turnos de conversacion inyectados como contexto en la ruta generativa.
# Mas contexto = mas coherencia y mas latencia.
SESSION_CONTEXT_TURNS=6

# Techo de tokens generados por comando. Es la palanca mas directa contra los
# desbordamientos del objetivo de latencia: en la ejecucion de referencia el
# 12,96 % de las muestras excedio su objetivo, todas en la clase proc_scan y
# por longitud de salida.
MAX_TOKENS=64

# --- Persona ----------------------------------------------------------------
# Semilla del generador determinista. Fijarla hace el despliegue reproducible.
PERSONA_SEED=1803

# --- Puertos ----------------------------------------------------------------
DECOY_SSH_PORT=2222
AGENT_API_PORT=8000

# --- Logs -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Normalizacion de latencia ----------------------------------------------
# El tiempo de respuesta debe depender del comando, nunca de la ruta que lo
# resuelve. Sin esto la ruta determinista (~2 ms) y la generativa (~2 s) forman
# dos poblaciones separables y un atacante que cronometre detecta el senuelo.
# Poner a false SOLO para medir el sistema sin normalizar (linea base del cap. 4).
LATENCY_NORMALIZE=true

# RTT mediano atribuido a una sesion y su dispersion log-normal.
# Constante dentro de una sesion: un atacante conecta por una sola ruta de red.
# 700 ms modela un servidor de produccion cargado tras un enlace lento. Es el
# valor que hace que la ruta generativa quepa dentro de la banda: por debajo,
# ninguna respuesta del modelo llega a tiempo y la normalizacion no se sostiene.
LATENCY_RTT_MEDIAN_MS=700
LATENCY_RTT_SIGMA=0.25

# Techo del objetivo sorteado, como multiplo de la mediana de su clase.
LATENCY_TAIL_CAP=6

# --- Presupuesto de generacion ----------------------------------------------
# El relleno solo puede anadir tiempo. Si el modelo sigue escribiendo cuando su
# objetivo ya vencio, esa muestra queda separable haga lo que haga la
# normalizacion: es exactamente lo que ocurria con `lsblk` y `vmstat 1 1`, que
# agotaban MAX_TOKENS y dejaban la clase proc_scan separable con AUC = 1,00.
# La unica defensa es haber generado menos, y eso es lo que decide esto.
GEN_BUDGET=true

# Suelo de tokens: por debajo de una linea de salida el problema deja de ser el
# tiempo y pasa a ser el contenido. Subirlo mejora la verosimilitud y aumenta
# los desbordes; bajarlo, al reves. Es la perilla del compromiso del capitulo 4.
GEN_MIN_TOKENS=12

# Fraccion del objetivo que la ruta generativa planea consumir. El resto
# absorbe la varianza que la estimacion no puede predecir.
GEN_SAFETY=0.75

# Semillas de los dos terminos del coste de generacion, en ms. Ambos se
# reestiman a partir de las respuestas reales del modelo, asi que solo importan
# durante los primeros comandos: son los valores medidos en la maquina de
# referencia. En una maquina con CUDA quedaran muy por encima y se corregiran
# solos en cuanto haya observaciones.
GEN_MS_PER_TOKEN=12
GEN_PROMPT_OVERHEAD_MS=250
GEN_EWMA_ALPHA=0.3

# Contexto replicado al modelo, completo y reducido. El reducido se usa cuando
# el completo no cabe en el objetivo: evaluar el prompt es el suelo que ningun
# presupuesto de tokens puede rebajar. Cuesta coherencia de sesion.
GEN_CONTEXT_CHARS=600
GEN_LEAN_CONTEXT_TURNS=2
GEN_LEAN_CONTEXT_CHARS=160
