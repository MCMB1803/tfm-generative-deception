# Copia este fichero a .env y ajusta los valores.
# NUNCA subas .env al repositorio: esta en .gitignore.

# --- Modelo de inferencia ---------------------------------------------------
MODEL_NAME=qwen2.5-coder:3b

# --- Objetivo de rendimiento ------------------------------------------------
# Umbral de latencia en ms. Por encima se emite un evento system.latency_breach.
LATENCY_TARGET_MS=1000

# Turnos de conversacion inyectados como contexto en la ruta generativa.
# Mas contexto = mas coherencia y mas latencia.
SESSION_CONTEXT_TURNS=6

# Techo de tokens generados por comando.
MAX_TOKENS=220

# --- Persona ----------------------------------------------------------------
# Semilla del generador determinista. Fijarla hace el despliegue reproducible.
PERSONA_SEED=1803

# --- Puertos ----------------------------------------------------------------
DECOY_SSH_PORT=2222
AGENT_API_PORT=8000

# --- Logs -------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Normalizacion de latencia ----------------------------------------------
# El tiempo de respuesta debe depender del comando, nunca de la ruta que lo
# resuelve. Sin esto la ruta determinista (~2 ms) y la generativa (~2 s) forman
# dos poblaciones separables y un atacante que cronometre detecta el senuelo.
# Poner a false SOLO para medir el sistema sin normalizar (linea base del cap. 4).
LATENCY_NORMALIZE=true

# RTT mediano atribuido a una sesion y su dispersion log-normal.
# Constante dentro de una sesion: un atacante conecta por una sola ruta de red.
LATENCY_RTT_MEDIAN_MS=25
LATENCY_RTT_SIGMA=0.55

# Techo del objetivo sorteado, como multiplo de la mediana de su clase.
LATENCY_TAIL_CAP=6
