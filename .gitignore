# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/

# Docker y persistencia local
ollama_storage/
ollama_data/
*.log

# Variables de entorno y secretos
.env
*.pem
*.key

# IDEs
.vscode/
.idea/

# Datos de ejecucion
data/

# Entornos y artefactos de pruebas locales
.venv-test/
.localtest/

# Memoria del TFM (trabajo en curso, no se publica)
docs/memoria/

# Claves de host generadas en pruebas
ssh_host_*_key
ssh_host_*_key.pub

# Resultados del banco de pruebas: se versiona la ejecucion de referencia
# (ver benchmarks/results), no las ejecuciones intermedias.
benchmarks/results/*
!benchmarks/results/RESULTS.md
!benchmarks/results/latency_samples.csv
!benchmarks/results/latency_summary.json
!benchmarks/results/RESOURCES.md
!benchmarks/results/resources_samples.csv
!benchmarks/results/resources_summary.json
!benchmarks/results/SIEM_VALIDATION.md
# Comparativa con Cowrie: es la evidencia del apartado 4.4 de la memoria,
# asi que se versiona igual que el resto de resultados de referencia.
!benchmarks/results/COMPARISON.md
!benchmarks/results/comparison_cowrie.json

# Resultados de la emulacion de adversarios: se versiona el informe y las
# transcripciones de la ejecucion de referencia, no las intermedias.
evaluation/results/*
!evaluation/results/DECEPTION_EVAL.md
!evaluation/results/transcripts.jsonl
!evaluation/results/verdicts.jsonl
